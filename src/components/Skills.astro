---
const skillGroups = [
  {
    title: 'Web Development',
    level: 'Intermediate',
    items: [
      ['HTML', 'Beginner'],
      ['CSS', 'Intermediate'],
      ['JavaScript', 'Beginner'],
      ['Astro', 'Intermediate'],
      ['React', 'Beginner'],
    ],
  },
  {
    title: 'Development Tools',
    level: 'Intermediate',
    items: [
      ['Git', 'Intermediate'],
      ['GitHub', 'Intermediate'],
      ['Vercel', 'Intermediate'],
      ['Visual Studio Code', 'Intermediate'],
    ],
  },
  {
    title: 'Design',
    level: 'Intermediate',
    items: [
      ['Photoshop', 'Intermediate'],
      ['Canva', 'Intermediate'],
      ['Figma', 'Intermediate'],
    ],
  },
  {
    title: 'AI',
    level: 'Intermediate',
    items: [['AI tools', 'Intermediate']],
  },
];
---
<section class="section section-shell" id="skills" data-reveal>
  <div class="section-heading">
    <div>
      <div class="eyebrow">Skills</div>
      <h2>Tools I’m <span>learning and improving.</span></h2>
    </div>
    <p>These are the technologies and tools I use while building, designing, and continuing to grow my skills.</p>
  </div>

  <div class="skills-grid">
    {skillGroups.map((group) => (
      <article class="skill-card glass">
        <div class="skill-header">
          <span class="skill-level">{group.level}</span>
          <h3>{group.title}</h3>
        </div>
        <div class="skill-list">
          {group.items.map(([name, level]) => (
            <span class="skill-tag">
              {name}
              <small>{level}</small>
            </span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
