---
const skillGroups = [
  {
    title: 'Web Development',
    level: 'Intermediate',
    items: [
      ['HTML', 'Beginner'],
      ['CSS', 'Intermediate'],
      ['JavaScript', 'Beginner'],
      ['Astro', 'Intermediate'],
      ['React', 'Beginner'],
    ],
  },
  {
    title: 'Development Tools',
    level: 'Intermediate',
    items: [
      ['Git', 'Intermediate'],
      ['GitHub', 'Intermediate'],
      ['Vercel', 'Intermediate'],
      ['Visual Studio Code', 'Intermediate'],
    ],
  },
  {
    title: 'Design',
    level: 'Intermediate',
    items: [
      ['Photoshop', 'Intermediate'],
      ['Canva', 'Intermediate'],
      ['Figma', 'Intermediate'],
    ],
  },
  {
    title: 'AI',
    level: 'Intermediate',
    items: [['AI tools', 'Intermediate']],
  },
];
---
<section class="section section-shell" id="skills" data-reveal>
  <div class="section-heading">
    <div>
      <div class="eyebrow" data-i18n="skills.eyebrow">Skills</div>
      <h2><span data-i18n="skills.title">Tools I’m</span> <span data-i18n="skills.titleAccent">learning and improving.</span></h2>
    </div>
    <p data-i18n="skills.description">These are the technologies and tools I use while building, designing, and continuing to grow my skills.</p>
  </div>

  <div class="skills-grid">
    {skillGroups.map((group) => (
      <article class="skill-card glass">
        <div class="skill-header">
          <span class="skill-level" data-i18n="levels.intermediate">{group.level}</span>
          <h3 data-i18n={`skills.${group.title === 'Web Development' ? 'webDevelopment' : group.title === 'Development Tools' ? 'developmentTools' : group.title.toLowerCase()}`}>{group.title}</h3>
        </div>
        <div class="skill-list">
          {group.items.map(([name, level]) => (
            <span class="skill-tag">
              {name}
              <small data-i18n={level === 'Beginner' ? 'levels.beginner' : 'levels.intermediate'}>{level}</small>
            </span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
