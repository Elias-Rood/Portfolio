<section class="section section-shell" id="education" data-reveal>
  <div class="education-grid">
    <article class="info-card glass">
      <div class="eyebrow" data-i18n="education.eyebrow">Education</div>
      <h2 data-i18n="education.title">Education</h2>
      <div class="info-list">
        <div class="info-item">
          <span data-i18n="education.schoolLabel">School</span>
          <strong data-i18n="education.school">El Paso High School</strong>
        </div>
        <div class="info-item">
          <span data-i18n="education.statusLabel">Status</span>
          <strong data-i18n="education.student">Student</strong>
        </div>
        <div class="info-item">
          <span data-i18n="education.goalsLabel">Career Goals</span>
          <strong data-i18n="education.careerGoals">Software Engineer, Designer, Entrepreneur</strong>
        </div>
      </div>
    </article>

    <article class="info-card glass">
      <div class="eyebrow" data-i18n="education.certifications">Certifications</div>
      <h2 data-i18n="education.certifications">Certifications</h2>
      <div class="cert-list">
        <div class="cert-item">
          <span class="badge success" data-i18n="education.completed">Completed</span>
          <strong data-i18n="education.wordSpecialist">Microsoft Word Specialist</strong>
        </div>
        <div class="cert-item">
          <span class="badge pending" data-i18n="education.inProgress">In Progress</span>
          <strong data-i18n="education.uiux">UI/UX Designer</strong>
        </div>
      </div>
    </article>
  </div>
</section>
