---
const projects = [
  {
    name: 'Linaje Bendito',
    role: 'Website Administrator / Designer',
    status: 'Ongoing',
    url: 'https://linajebendito.org/home',
    description: 'I helped manage the information and content of the Linaje Bendito website while also working on its design and development.',
    tech: [],
    image: '/images/projects/linaje-bendito.svg',
    alt: 'Linaje Bendito project mockup',
  },
  {
    name: 'ErStudio Portfolio',
    role: 'Web Developer & Designer',
    status: 'Ongoing',
    url: '#home',
    description: 'This portfolio website is an ongoing project created to showcase my development, design and entrepreneurial work.',
    tech: ['Astro', 'CSS', 'JavaScript'],
    image: '/images/projects/portfolio.svg',
    alt: 'ErStudio portfolio project mockup',
  },
];
---
<section class="section section-shell" id="projects" data-reveal>
  <div class="section-heading">
    <div>
      <div class="eyebrow" data-i18n="projects.eyebrow">Projects</div>
      <h2><span data-i18n="projects.title">Selected</span> <span data-i18n="projects.titleAccent">work.</span></h2>
    </div>
    <p data-i18n="projects.description">Real projects that reflect my learning, design process, and work as a developing web developer.</p>
  </div>

  <div class="project-list">
    {projects.map((project) => (
      <article class="project-card glass">
        <div class="project-media">
          <img src={project.image} alt={project.alt} width="900" height="600" loading="lazy" />
        </div>
        <div class="project-info">
          <div class="project-meta">
            <span data-i18n={project.role === 'Website Administrator / Designer' ? 'projects.linajeRole' : 'projects.portfolioRole'}>{project.role}</span>
            <span class="status-badge" data-i18n="projects.ongoing">{project.status}</span>
          </div>
          <h3>{project.name}</h3>
          <p data-i18n={project.name === 'Linaje Bendito' ? 'projects.linajeDescription' : 'projects.portfolioDescription'}>{project.description}</p>

          {project.tech.length > 0 && (
            <div class="tech-list">
              {project.tech.map((technology) => <span>{technology}</span>)}
            </div>
          )}

          <div class="project-links">
            <a href={project.url} target={project.url.startsWith('http') ? '_blank' : undefined} rel={project.url.startsWith('http') ? 'noreferrer' : undefined}>
              <span data-i18n="projects.viewProject">View Project</span> <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
