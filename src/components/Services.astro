---
const services = [
  ['01', 'Web Design', 'Create modern, responsive and visually appealing websites.'],
  ['02', 'Web Development', 'Build functional websites using modern web technologies.'],
  ['03', 'Website Maintenance', 'Manage, update and maintain websites after launch.'],
  ['04', 'Hosting', 'Provide hosting solutions for websites.'],
];
---
<section class="section section-shell" id="services" data-reveal>
  <div class="section-heading">
    <div>
      <div class="eyebrow">Services</div>
      <h2>What ErStudio <span>offers.</span></h2>
    </div>
    <p>I help businesses and individuals build a cleaner, more professional online presence with clear and reliable support.</p>
  </div>

  <div class="services-grid">
    {services.map(([number, name, description]) => (
      <article class="service-card glass">
        <span class="service-number">0{number}</span>
        <h3>{name}</h3>
        <p>{description}</p>
      </article>
    ))}
  </div>
</section>
