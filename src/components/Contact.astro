<section class="section section-shell" id="contact" data-reveal>
  <div class="contact-layout"><div class="contact-details"><div class="eyebrow">Start a conversation</div><h2>Let's make<br /><span>something good.</span></h2><p>Have a question, an early idea, or a project that needs a digital home? Send a note and I will get back to you.</p><div class="contact-links"><a class="contact-link" href="mailto:email@example.com"><span>Email</span><span>email@example.com</span></a><a class="contact-link" href="https://github.com/USERNAME" target="_blank" rel="noreferrer"><span>GitHub</span><span>github.com/USERNAME</span></a><a class="contact-link" href="https://instagram.com/USERNAME" target="_blank" rel="noreferrer"><span>Instagram</span><span>@USERNAME</span></a><a class="contact-link" href="https://linkedin.com/in/USERNAME" target="_blank" rel="noreferrer"><span>LinkedIn</span><span>/in/USERNAME</span></a></div></div><form class="contact-form glass" data-contact-form><div class="form-row"><div class="field"><label for="name">Name</label><input id="name" name="name" type="text" placeholder="Your name" required /></div><div class="field"><label for="email">Email</label><input id="email" name="email" type="email" placeholder="you@example.com" required /></div></div><div class="field"><label for="message">Message</label><textarea id="message" name="message" placeholder="Tell me a little about your idea..." required></textarea></div><p class="form-note" data-form-note aria-live="polite"></p><button class="button button-dark" type="submit">Send message <span aria-hidden="true">↗</span></button></form></div>
</section>
