---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Elias Rodriguez | Web Developer & Designer | ErStudio',
  description = 'Elias Rodriguez is a student entrepreneur and web developer & designer building modern websites for small businesses and individuals through ErStudio.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090d17" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body data-theme="dark">
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>
    <slot />
    <script>
      const body = document.body;
      const menuButton = document.querySelector('[data-menu-button]');
      const mobileMenu = document.querySelector('[data-mobile-menu]');
      const themeButtons = document.querySelectorAll<HTMLElement>('[data-theme-toggle]');
      const languageSelects = document.querySelectorAll<HTMLSelectElement>('[data-language-select]');
      const languageChoices = document.querySelectorAll<HTMLButtonElement>('[data-language-choice]');
      const translations: Record<string, Record<string, string>> = {
        en: {
          'nav.home': 'Home', 'nav.about': 'About', 'nav.skills': 'Skills', 'nav.services': 'Services', 'nav.projects': 'Projects', 'nav.education': 'Education', 'nav.contact': 'Contact',
          'hero.name': 'Elias Rodriguez', 'hero.role': 'Web Developer &amp; Designer', 'hero.description': 'Building modern websites and digital experiences for small businesses and individuals.', 'hero.tagline': 'Student. Developer. Designer. Entrepreneur.', 'hero.work': 'View My Work', 'common.contactMe': 'Contact Me', 'hero.webDesign': 'Web Design', 'hero.webDevelopment': 'Web Development', 'hero.entrepreneur': 'Entrepreneur',
          'about.eyebrow': 'Who I Am', 'about.title': 'About', 'about.intro': "I'm Elias Rodriguez, a student entrepreneur focused on web development and design. I'm building my skills through real projects while working toward my future as a software engineer, designer and entrepreneur.", 'about.whyTitle': 'Why I Started', 'about.whyText': 'I became interested in web development and design because I saw it as a great way to begin building experience for my career while creating something useful for other people.', 'about.goalTitle': "Where I'm Going", 'about.goalText': 'My goal is to grow ErStudio, create better digital experiences, and build long-term trust with the people and businesses I work with.', 'about.timeTitle': 'Time', 'about.timeText': "I value efficient work and respect the client's time.", 'about.qualityTitle': 'Quality', 'about.qualityText': 'I focus on creating websites that are clean, responsive and useful.', 'about.communicationTitle': 'Communication', 'about.communicationText': 'I believe clear communication makes projects easier for everyone.', 'about.agreementsTitle': 'Agreements', 'about.agreementsText': 'Clear project agreements help define expectations, responsibilities and deliverables before work begins.',
          'skills.eyebrow': 'Skills', 'skills.title': 'Tools I’m', 'skills.titleAccent': 'learning and improving.', 'skills.description': 'These are the technologies and tools I use while building, designing, and continuing to grow my skills.', 'skills.webDevelopment': 'Web Development', 'skills.developmentTools': 'Development Tools', 'skills.design': 'Design', 'skills.ai': 'AI', 'levels.beginner': 'Beginner', 'levels.intermediate': 'Intermediate',
          'services.eyebrow': 'Services', 'services.title': 'What ErStudio', 'services.titleAccent': 'offers.', 'services.description': 'I help businesses and individuals build a cleaner, more professional online presence with clear and reliable support.', 'services.01.name': 'Web Design', 'services.01.description': 'Create modern, responsive and visually appealing websites.', 'services.02.name': 'Web Development', 'services.02.description': 'Build functional websites using modern web technologies.', 'services.03.name': 'Website Maintenance', 'services.03.description': 'Manage, update and maintain websites after launch.', 'services.04.name': 'Hosting', 'services.04.description': 'Provide hosting solutions for websites.',
          'projects.eyebrow': 'Projects', 'projects.title': 'Selected', 'projects.titleAccent': 'work.', 'projects.description': 'Real projects that reflect my learning, design process, and work as a developing web developer.', 'projects.linajeRole': 'Website Administrator / Designer', 'projects.portfolioRole': 'Web Developer &amp; Designer', 'projects.ongoing': 'Ongoing', 'projects.linajeDescription': 'I helped manage the information and content of the Linaje Bendito website while also working on its design and development.', 'projects.portfolioDescription': 'This portfolio website is an ongoing project created to showcase my development, design and entrepreneurial work.', 'projects.viewProject': 'View Project',
          'education.eyebrow': 'Education', 'education.title': 'Education', 'education.schoolLabel': 'School', 'education.statusLabel': 'Status', 'education.goalsLabel': 'Career Goals', 'education.school': 'El Paso High School', 'education.student': 'Student', 'education.careerGoals': 'Software Engineer, Designer, Entrepreneur', 'education.certifications': 'Certifications', 'education.completed': 'Completed', 'education.inProgress': 'In Progress', 'education.wordSpecialist': 'Microsoft Word Specialist', 'education.uiux': 'UI/UX Designer',
          'contact.eyebrow': 'Contact', 'contact.ctaTitle': 'Have a project<br /><span>in mind?</span>', 'contact.ctaText': "Let's build something that represents you and your business.", 'contact.reachOut': 'Reach out', 'contact.title': "Let's talk <span>about your next website.</span>", 'contact.description': 'I’m currently building ErStudio and working with small businesses and individuals who want a professional online presence that feels clear, modern, and trustworthy.', 'contact.instagram': 'Instagram', 'contact.github': 'GitHub', 'contact.email': 'Email', 'contact.whatsapp': 'WhatsApp', 'contact.emailMe': 'Email Me', 'footer.role': 'Web Developer &amp; Designer'
        },
        es: {
          'nav.home': 'Inicio', 'nav.about': 'Sobre mí', 'nav.skills': 'Habilidades', 'nav.services': 'Servicios', 'nav.projects': 'Proyectos', 'nav.education': 'Educación', 'nav.contact': 'Contacto',
          'hero.name': 'Elias Rodriguez', 'hero.role': 'Desarrollador web y diseñador', 'hero.description': 'Creo sitios web modernos y experiencias digitales para pequeños negocios y personas.', 'hero.tagline': 'Estudiante. Desarrollador. Diseñador. Emprendedor.', 'hero.work': 'Ver mi trabajo', 'common.contactMe': 'Contáctame', 'hero.webDesign': 'Diseño web', 'hero.webDevelopment': 'Desarrollo web', 'hero.entrepreneur': 'Emprendedor',
          'about.eyebrow': 'Quién soy', 'about.title': 'Sobre', 'about.intro': 'Soy Elias Rodriguez, un estudiante emprendedor enfocado en el desarrollo y diseño web. Desarrollo mis habilidades con proyectos reales mientras construyo mi futuro como ingeniero de software, diseñador y emprendedor.', 'about.whyTitle': 'Por qué empecé', 'about.whyText': 'Me interesé en el desarrollo y diseño web porque lo vi como una gran forma de ganar experiencia para mi carrera mientras creo algo útil para otras personas.', 'about.goalTitle': 'Hacia dónde voy', 'about.goalText': 'Mi meta es hacer crecer ErStudio, crear mejores experiencias digitales y construir confianza a largo plazo con las personas y negocios con los que trabajo.', 'about.timeTitle': 'Tiempo', 'about.timeText': 'Valoro el trabajo eficiente y respeto el tiempo de mis clientes.', 'about.qualityTitle': 'Calidad', 'about.qualityText': 'Me enfoco en crear sitios web limpios, responsivos y útiles.', 'about.communicationTitle': 'Comunicación', 'about.communicationText': 'Creo que una comunicación clara facilita los proyectos para todos.', 'about.agreementsTitle': 'Acuerdos', 'about.agreementsText': 'Los acuerdos claros definen expectativas, responsabilidades y entregables antes de comenzar.',
          'skills.eyebrow': 'Habilidades', 'skills.title': 'Herramientas que', 'skills.titleAccent': 'estoy aprendiendo.', 'skills.description': 'Estas son las tecnologías y herramientas que uso mientras construyo, diseño y sigo desarrollando mis habilidades.', 'skills.webDevelopment': 'Desarrollo web', 'skills.developmentTools': 'Herramientas de desarrollo', 'skills.design': 'Diseño', 'skills.ai': 'IA', 'levels.beginner': 'Principiante', 'levels.intermediate': 'Intermedio',
          'services.eyebrow': 'Servicios', 'services.title': 'Lo que ErStudio', 'services.titleAccent': 'ofrece.', 'services.description': 'Ayudo a negocios y personas a construir una presencia en línea más limpia y profesional con apoyo claro y confiable.', 'services.01.name': 'Diseño web', 'services.01.description': 'Creo sitios web modernos, responsivos y visualmente atractivos.', 'services.02.name': 'Desarrollo web', 'services.02.description': 'Construyo sitios funcionales usando tecnologías web modernas.', 'services.03.name': 'Mantenimiento web', 'services.03.description': 'Administro, actualizo y mantengo sitios web después de su lanzamiento.', 'services.04.name': 'Hosting', 'services.04.description': 'Ofrezco soluciones de hosting para sitios web.',
          'projects.eyebrow': 'Proyectos', 'projects.title': 'Trabajo', 'projects.titleAccent': 'seleccionado.', 'projects.description': 'Proyectos reales que reflejan mi aprendizaje, proceso de diseño y trabajo como desarrollador web en crecimiento.', 'projects.linajeRole': 'Administrador / diseñador web', 'projects.portfolioRole': 'Desarrollador web y diseñador', 'projects.ongoing': 'En progreso', 'projects.linajeDescription': 'Ayudé a administrar la información y el contenido del sitio web de Linaje Bendito, además de trabajar en su diseño y desarrollo.', 'projects.portfolioDescription': 'Este portafolio es un proyecto en progreso creado para mostrar mi trabajo de desarrollo, diseño y emprendimiento.', 'projects.viewProject': 'Ver proyecto',
          'education.eyebrow': 'Educación', 'education.title': 'Educación', 'education.schoolLabel': 'Escuela', 'education.statusLabel': 'Estado', 'education.goalsLabel': 'Metas profesionales', 'education.school': 'Escuela Secundaria El Paso', 'education.student': 'Estudiante', 'education.careerGoals': 'Ingeniero de software, diseñador, emprendedor', 'education.certifications': 'Certificaciones', 'education.completed': 'Completado', 'education.inProgress': 'En progreso', 'education.wordSpecialist': 'Especialista en Microsoft Word', 'education.uiux': 'Diseñador UI/UX',
          'contact.eyebrow': 'Contacto', 'contact.ctaTitle': '¿Tienes un proyecto<br /><span>en mente?</span>', 'contact.ctaText': 'Construyamos algo que represente tu negocio y a ti.', 'contact.reachOut': 'Hablemos', 'contact.title': 'Hablemos <span>sobre tu próximo sitio web.</span>', 'contact.description': 'Actualmente estoy construyendo ErStudio y trabajando con pequeños negocios y personas que buscan una presencia profesional en línea, clara, moderna y confiable.', 'contact.instagram': 'Instagram', 'contact.github': 'GitHub', 'contact.email': 'Correo', 'contact.whatsapp': 'WhatsApp', 'contact.emailMe': 'Envíame un correo', 'footer.role': 'Desarrollador web y diseñador'
        }
      };

      const applyLanguage = (language: string) => {
        const dictionary = translations[language] || translations.en;
        document.documentElement.lang = language;
        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((element) => {
          const key = element.dataset.i18n;
          if (key) {
            const value = dictionary[key];
            if (value) element.innerHTML = value;
          }
        });
        languageSelects.forEach((select) => { select.value = language; });
        languageChoices.forEach((choice) => {
          const isActive = choice.dataset.languageChoice === language;
          choice.classList.toggle('is-active', isActive);
          choice.setAttribute('aria-pressed', String(isActive));
        });
      };

      const applyTheme = (theme: string) => {
        body.dataset.theme = theme;
        document.querySelectorAll('[data-theme-icon]').forEach((icon) => {
          icon.textContent = theme === 'dark' ? '☀️' : '🌙';
        });
        document.querySelectorAll('[data-theme-label]').forEach((label) => {
          label.textContent = theme === 'dark' ? 'Light Mode' : 'Dark Mode';
        });
        themeButtons.forEach((button) => {
          const isDark = theme === 'dark';
          button.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
          button.setAttribute('title', isDark ? 'Switch to light mode' : 'Switch to dark mode');
          button.dataset.active = isDark ? 'dark' : 'light';
        });
      };

      const savedTheme = localStorage.getItem('erstudio-theme');
      applyTheme(savedTheme || 'dark');
      const savedLanguage = localStorage.getItem('erstudio-language') || 'en';
      applyLanguage(savedLanguage);

      menuButton?.addEventListener('click', () => {
        const isOpen = mobileMenu?.classList.toggle('is-open');
        menuButton.setAttribute('aria-expanded', String(isOpen));
      });

      document.querySelectorAll('[data-mobile-menu] a').forEach((link) => {
        link.addEventListener('click', () => mobileMenu?.classList.remove('is-open'));
      });

      themeButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const nextTheme = body.dataset.theme === 'dark' ? 'light' : 'dark';
          localStorage.setItem('erstudio-theme', nextTheme);
          applyTheme(nextTheme);
        });
      });

      languageSelects.forEach((select) => {
        select.addEventListener('change', () => {
          localStorage.setItem('erstudio-language', select.value);
          applyLanguage(select.value);
        });
      });

      languageChoices.forEach((choice) => {
        choice.addEventListener('click', () => {
          const language = choice.dataset.languageChoice || 'en';
          localStorage.setItem('erstudio-language', language);
          applyLanguage(language);
        });
      });

      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });

      document.querySelectorAll('[data-reveal]').forEach((element) => revealObserver.observe(element));
    </script>
  </body>
</html>
